PORT=3001
NODE_ENV=development

# 리버스 프록시(ALB·nginx 등) 뒤에서 뜰 때만 true.
# 켜지 않으면 요청 제한이 모든 요청을 프록시 IP 하나로 세어 한 사람이 전체를 잠급니다.
TRUST_PROXY=false

# 운영에서 Swagger 를 열려면 true. 기본은 비공개입니다.
ENABLE_SWAGGER=false

# PostgreSQL
DATABASE_URL=postgresql://planforge:planforge@localhost:5432/planforge?schema=public

# 허용할 프론트엔드 오리진 (쉼표 구분)
CORS_ORIGIN=http://localhost:3000

# JWT — 32자 이상이어야 하며, 없으면 서버가 기동하지 않습니다.
# 운영에서는 반드시 새로 생성하세요: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# 시드가 만드는 초기 계정의 비밀번호 (개발용). 8자 이상.
SEED_PASSWORD=planforge

# PlanForge Core (Oracle OPERA / OHIP 게이트웨이)
CORE_BASE_URL=http://localhost:3002
CORE_API_KEY=
CORE_REQUEST_TIMEOUT_MS=15000
