# PlanForge 배포 환경변수. 이 파일을 .env 로 복사해 값을 채우세요.
# .env 는 절대 커밋하지 않습니다.

# 올릴 이미지 태그. 커밋 SHA 나 릴리스 버전을 권장합니다 — latest 는
# 무엇이 떠 있는지 알 수 없어 롤백이 어렵습니다.
IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=planforge
POSTGRES_PASSWORD=
POSTGRES_DB=planforge

# --- 공개 주소 ---
FE_PORT=3000
# FE 가 실제로 서비스되는 오리진. 쉼표로 여러 개 지정 가능합니다.
CORS_ORIGIN=https://planforge.example.com

# --- BE ---
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 리버스 프록시(ALB·nginx 등) 뒤에 둘 때만 true.
# 켜지 않으면 요청 제한이 모든 요청을 프록시 IP 하나로 세어 한 사람이 전체를 잠급니다.
TRUST_PROXY=false

# 최초 1회만 true 로 두어 초기 계정을 만들고, 이후 false 로 되돌리세요.
RUN_SEED=false
SEED_PASSWORD=

# --- BE ↔ Core 내부 인증 ---
# openssl rand -base64 32
SERVICE_API_KEY=

# --- Oracle Hospitality Integration Platform ---
OHIP_BASE_URL=
OHIP_APP_KEY=
OHIP_CLIENT_ID=
OHIP_CLIENT_SECRET=
OHIP_USERNAME=
OHIP_PASSWORD=
OHIP_HOTEL_ID=
