// PlanForge BE — 호텔 관리 플랫폼 데이터 모델
//
// Oracle OPERA Cloud 의 개념(Property / Room Type / Profile / Reservation / Folio)을
// 그대로 따르되, PlanForge 자체 식별자를 1차 키로 두고 OPERA 식별자는 `opera*Id`
// 필드로 함께 보관한다. Core(API Server)가 OHIP 과 동기화할 때 이 필드를 매칭 키로 쓴다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 계정 / 권한
// ---------------------------------------------------------------------------

/// 업무 역할. 호텔 조직도를 그대로 따른다.
enum UserRole {
  /// 계정 관리까지 포함한 전체 권한
  ADMIN
  /// 운영 전반. 계정 관리는 제외
  MANAGER
  /// 예약·체크인/아웃·폴리오
  FRONT_DESK
  /// 객실 상태 변경만
  HOUSEKEEPING
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt 해시. 평문은 어디에도 저장하지 않는다.
  passwordHash String
  name         String
  role         UserRole  @default(FRONT_DESK)
  /// 소속 호텔. null 이면 전 호텔 접근(본사 계정).
  propertyId   String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  housekeepingTasks HousekeepingTask[]
  issuedRoomKeys    RoomKey[]
  payments          Payment[]
  roomOutages       RoomOutage[]
  folioRoutings     FolioRouting[]
  transferredPostings Posting[]

  @@index([propertyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// 조직 / 자산
// ---------------------------------------------------------------------------

model Property {
  id           String   @id @default(cuid())
  /// OPERA hotelId (chain 내 호텔 코드)
  operaHotelId String   @unique
  name         String
  timezone     String   @default("Asia/Seoul")
  currency     String   @default("KRW")
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomTypes         RoomType[]
  rooms             Room[]
  ratePlans         RatePlan[]
  reservations      Reservation[]
  users             User[]
  housekeepingTasks HousekeepingTask[]
  blocks            Block[]
  posOutlets        PosOutlet[]
  roomKeys          RoomKey[]
  roomOutages       RoomOutage[]

  @@map("properties")
}

model RoomType {
  id           String   @id @default(cuid())
  propertyId   String
  /// OPERA roomType 코드 (예: DLXK)
  code         String
  name         String
  description  String?
  maxOccupancy Int      @default(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]

  @@unique([propertyId, code])
  @@map("room_types")
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

model Room {
  id         String     @id @default(cuid())
  propertyId String
  roomTypeId String
  /// OPERA roomId (객실 번호)
  number     String
  floor      String?
  status     RoomStatus @default(CLEAN)
  occupied   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  housekeepingTasks HousekeepingTask[]
  outages           RoomOutage[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@map("rooms")
}

/// 객실을 판매에서 빼는 두 가지 방식. 실적 집계가 달라진다.
enum RoomOutageKind {
  /// 물리적으로 쓸 수 없다. 재고에서 빠지므로 점유율 분모도 줄어든다.
  OUT_OF_ORDER
  /// 팔지 않을 뿐 객실은 멀쩡하다. 재고에는 남아 점유율 분모는 그대로다.
  OUT_OF_SERVICE
}

/// 사용 불가 객실 기간. OPERA 가 원천이고 여기 있는 것은 그 사본이다.
model RoomOutage {
  id           String         @id @default(cuid())
  propertyId   String
  roomId       String
  /// OPERA 가 부여한 식별자. 해제할 때 이 값으로 지운다.
  operaId      String         @unique
  kind         RoomOutageKind
  /// 사용 불가 시작일(포함)
  startDate    DateTime       @db.Date
  /// 사용 불가 종료일(포함). 이 날까지 팔 수 없다.
  endDate      DateTime       @db.Date
  reason       String
  /// 기간이 끝나면 되돌릴 하우스키핑 상태
  returnStatus RoomStatus     @default(DIRTY)
  createdById  String?
  releasedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([propertyId, startDate, endDate])
  @@index([roomId, releasedAt])
  @@map("room_outages")
}

model RatePlan {
  id         String   @id @default(cuid())
  propertyId String
  /// OPERA rateCode
  code       String
  name       String
  /// 최소 판매가(스냅샷). 실제 요금은 Core 를 통해 OPERA 에서 조회한다.
  baseAmount Decimal? @db.Decimal(12, 2)
  currency   String   @default("KRW")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([propertyId, code])
  @@map("rate_plans")
}

// ---------------------------------------------------------------------------
// 하우스키핑 작업 배정
// ---------------------------------------------------------------------------

/// 청소 작업 진행 상태. 객실 상태(RoomStatus)와는 다르다 —
/// 이쪽은 "직원이 어디까지 했는가", 저쪽은 "객실이 팔 수 있는 상태인가" 다.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  /// 점검까지 끝남. 객실 상태를 INSPECTED 로 올릴 근거가 된다.
  INSPECTED
}

/**
 * 하우스키핑 작업 배정.
 * 객실 상태는 OPERA 가 원천이지만, "누가 어느 객실을 청소하는가" 는 직원 근무
 * 편성이라 OPERA 에 보내지 않는다. PlanForge 가 소유한다.
 */
model HousekeepingTask {
  id           String     @id @default(cuid())
  propertyId   String
  roomId       String
  /// 배정된 직원. 아직 배정 전이면 null.
  assignedToId String?
  /// 근무일. 같은 객실이라도 날짜마다 별개의 작업이다.
  date         DateTime   @db.Date
  status       TaskStatus @default(PENDING)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  /// 같은 객실·같은 날짜에 작업이 둘 생기면 누가 담당인지 알 수 없다.
  @@unique([roomId, date])
  @@index([propertyId, date, status])
  @@index([assignedToId, date])
  @@map("housekeeping_tasks")
}

// ---------------------------------------------------------------------------
// 단체 블록 (OPERA Block)
// ---------------------------------------------------------------------------

/// OPERA 블록 상태. DEFINITE 부터 재고를 실제로 잡는다.
enum BlockStatus {
  INQUIRY
  TENTATIVE
  DEFINITE
  CANCELLED
  ACTUAL
}

/**
 * 단체 블록의 로컬 사본.
 *
 * 원천은 OPERA 다. 여기 있는 값은 목록·검색을 빠르게 하려고 두는 캐시이고,
 * 생성·수정은 전부 Core 를 거쳐 OPERA 에 위임한 뒤 **OPERA 가 돌려준 값**으로
 * 다시 채운다. 우리가 보낸 값을 그대로 적으면 OPERA 가 조정한 결과를 놓친다.
 */
model Block {
  id            String      @id @default(cuid())
  /// OPERA blockId. 이것이 없으면 위임할 대상을 특정할 수 없다.
  operaBlockId  String?     @unique
  propertyId    String
  /// 예약 시 지정하는 블록 코드
  code          String
  name          String
  status        BlockStatus @default(TENTATIVE)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// 이 날짜가 지나면 잡아 둔 객실이 일반 재고로 풀린다.
  cutoffDate    DateTime?   @db.Date
  currency      String      @default("KRW")
  /// 합계 스냅샷. 할당을 매번 합산하지 않도록 미러링 시 함께 갱신한다.
  totalBlocked  Int         @default(0)
  totalPickedUp Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  allotments BlockAllotment[]

  @@unique([propertyId, code])
  @@index([propertyId, startDate])
  @@map("blocks")
}

/**
 * 일자·객실 타입별 할당.
 *
 * roomType 을 FK 가 아니라 코드 문자열로 들고 있는 이유: OPERA 가 우리 쪽에
 * 아직 동기화되지 않은 객실 타입을 돌려줄 수 있다. FK 로 묶으면 그때 미러링
 * 전체가 실패해 블록이 화면에서 통째로 사라진다.
 */
model BlockAllotment {
  id           String   @id @default(cuid())
  blockId      String
  date         DateTime @db.Date
  roomTypeCode String
  /// 잡아 둔 객실 수
  blocked      Int      @default(0)
  /// 실제 예약으로 빠져나간 수
  pickedUp     Int      @default(0)
  ratePlanCode String?
  amount       Decimal? @db.Decimal(12, 2)

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, date, roomTypeCode])
  @@map("block_allotments")
}

// ---------------------------------------------------------------------------
// 프로필 (OPERA Profile)
// ---------------------------------------------------------------------------

enum ProfileType {
  GUEST
  COMPANY
  TRAVEL_AGENT
  GROUP
}

/// 멤버십 등급. 호텔 체인마다 이름이 다르므로 코드로 두고 표기는 화면이 맡는다.
enum MembershipTier {
  NONE
  SILVER
  GOLD
  PLATINUM
}

model Profile {
  id             String      @id @default(cuid())
  /// OPERA profileId
  operaProfileId String?     @unique
  type           ProfileType @default(GUEST)
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  nationality    String?
  vip            Boolean     @default(false)

  /// 멤버십 번호. 체인 로열티 프로그램의 식별자.
  membershipNumber String?
  membershipTier   MembershipTier @default(NONE)

  /**
   * 선호 사항. 고층·금연·베개 종류처럼 배정에 영향을 주는 것들.
   *
   * 자유 텍스트가 아니라 코드 배열로 둔다. 텍스트로 받으면 "고층"·"높은 층"·
   * "high floor" 가 뒤섞여 배정할 때 아무도 걸러낼 수 없다.
   */
  preferences String[] @default([])

  /// 프론트에서 남기는 내부 메모. 게스트에게 노출하지 않는다.
  notes String?

  /**
   * 중복으로 판명되어 다른 프로필로 합쳐진 경우 그 대상.
   *
   * 지우지 않는 이유는 과거 예약이 이 프로필을 참조하고 있어서다. 삭제하면
   * 예약의 게스트가 사라지고, 남겨 두면 어느 쪽이 정본인지 알 수 있다.
   */
  mergedIntoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  mergedInto   Profile?      @relation("ProfileMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Profile[]     @relation("ProfileMerge")

  @@index([email])
  @@index([lastName, firstName])
  @@index([membershipNumber])
  @@index([mergedIntoId])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// 예약 (OPERA Reservation)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  RESERVED
  CONFIRMED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  WAITLISTED
}

model Reservation {
  id                 String            @id @default(cuid())
  /// OPERA reservationId
  operaReservationId String?           @unique
  /// 게스트에게 노출하는 확인 번호
  confirmationNumber String            @unique
  propertyId         String
  profileId          String
  roomTypeId         String
  ratePlanId         String?
  status             ReservationStatus @default(RESERVED)
  arrivalDate        DateTime          @db.Date
  departureDate      DateTime          @db.Date
  adults             Int               @default(1)
  children           Int               @default(0)
  /// 배정된 객실 번호. 미배정이면 null.
  assignedRoomNumber String?
  /// 단체 블록에서 빠져나온 예약이면 그 블록 코드.
  /// FK 가 아니라 코드인 이유는 블록이 아직 캐시되기 전에 예약이 먼저 들어올 수 있어서다.
  blockCode          String?

  /**
   * 예약이 들어온 경로. OPERA 가 세 축으로 나눈 것을 그대로 따른다.
   *
   * 하나로 합치면 "OTA 를 통해 들어온 법인 예약" 같은 조합을 구분할 수 없어
   * 채널별 수익성 판단이 무너진다.
   */
  /// 예약을 받은 방법 — DIRECT · PHONE · WALKIN · OTA · GDS · CORPORATE
  sourceCode  String?
  /// 손님의 성격 — TRANSIENT · CORPORATE · GROUP · LEISURE · GOVERNMENT
  marketCode  String?
  /// 구체적인 판매 채널 — WEB · BOOKINGCOM · EXPEDIA · YANOLJA …
  channelCode String?
  totalAmount        Decimal?          @db.Decimal(12, 2)
  currency           String            @default("KRW")
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  property Property  @relation(fields: [propertyId], references: [id])
  profile  Profile   @relation(fields: [profileId], references: [id])
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id])
  folios   Folio[]
  roomKeys RoomKey[]
  routings FolioRouting[]

  @@index([propertyId, arrivalDate])
  @@index([propertyId, status])
  @@index([propertyId, blockCode])
  @@index([propertyId, channelCode])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// 회계 (OPERA Folio / Transaction)
// ---------------------------------------------------------------------------

enum FolioStatus {
  OPEN
  CLOSED
}

model Folio {
  id            String      @id @default(cuid())
  /// OPERA folioId
  operaFolioId  String?     @unique
  reservationId String
  /// OPERA folio window 번호 (1~8)
  window        Int         @default(1)
  status        FolioStatus @default(OPEN)
  balance       Decimal     @default(0) @db.Decimal(12, 2)
  currency      String      @default("KRW")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  postings    Posting[]
  payments    Payment[]

  @@unique([reservationId, window])
  @@map("folios")
}

/**
 * 라우팅 지시 — 자동으로 붙는 요금을 어느 창구로 보낼지.
 *
 * 회사가 객실료를 내고 손님이 부대비용을 내는 편성이 흔하다. 요금이 붙을
 * 때마다 사람이 옮기면 반드시 빠뜨리는 것이 생기므로, 거래 코드별로 목적지를
 * 미리 정해 둔다.
 *
 * 프런트가 창구를 지정해 올리는 거래에는 적용하지 않는다 — 지정한 곳으로
 * 가야 한다. 적용 대상은 외부 POS 룸차지처럼 창구를 모르는 채 들어오는
 * 요금이다.
 */
model FolioRouting {
  id              String   @id @default(cuid())
  reservationId   String
  /// OPERA transactionCode. 이 코드의 요금을 targetWindow 로 보낸다.
  transactionCode String
  targetWindow    Int
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id])

  @@unique([reservationId, transactionCode])
  @@map("folio_routings")
}

/**
 * 외부 POS 아웃렛 — 레스토랑·바·스파·미니바.
 *
 * 객실로 요금을 다는 주체이지 사람이 아니다. 직원 계정을 쓰게 하면 단말에
 * 직원 비밀번호를 심게 되고, 그 단말이 직원 권한 전부를 얻는다. 아웃렛마다
 * 자기 키를 주고 그 키로 할 수 있는 일을 룸차지 하나로 좁힌다.
 */
model PosOutlet {
  id         String @id @default(cuid())
  propertyId String
  /// 아웃렛 코드 — RESTAURANT · BAR · SPA · MINIBAR
  code       String
  name       String
  /// 이 아웃렛이 다는 요금의 기본 거래 코드
  transactionCode String

  /// bcrypt 해시. 평문 키는 발급 순간에만 존재한다.
  apiKeyHash   String
  /// 화면에서 어느 키인지 알아볼 수 있게 앞자리만 남긴다.
  apiKeyPrefix String
  /// 키를 마지막으로 발급한 시각. 유출이 의심되면 재발급 이력을 본다.
  keyIssuedAt  DateTime @default(now())

  active    Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  postings Posting[]

  @@unique([propertyId, code])
  @@index([apiKeyPrefix])
  @@map("pos_outlets")
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum PaymentStatus {
  /// 승인만 받았다. 한도는 잡혔지만 돈은 오지 않았다.
  AUTHORIZED
  /// 매입까지 끝났다. 이때 폴리오에 결제가 올라간다.
  CAPTURED
  /// 매입 전에 승인을 취소했다.
  VOIDED
  /// 매입 후 되돌렸다. 부분 환불이면 금액이 남아 있을 수 있다.
  REFUNDED
  FAILED
}

/**
 * 결제.
 *
 * **카드 번호와 CVV 는 어디에도 저장하지 않는다.** 마스킹된 뒷자리와 PG 가 준
 * 거래 식별자만 남긴다. 저장하는 순간 이 시스템 전체가 카드 정보 보관 설비가
 * 되고, 유출 시 책임 범위가 달라진다.
 */
model Payment {
  id      String @id @default(cuid())
  folioId String

  method PaymentMethod
  status PaymentStatus @default(AUTHORIZED)
  amount Decimal       @db.Decimal(12, 2)
  /// 환불된 누적 금액. 부분 환불을 여러 번 받을 수 있다.
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("KRW")

  /// PG 의 거래 식별자. 매입·취소·환불을 걸 때 이 값으로 지정한다.
  vendorTxnId    String?
  /// 승인 번호. 카드사에 문의할 때 쓴다.
  approvalNumber String?
  /// 마스킹된 카드 번호 — 뒷 네 자리만. 전체 번호는 저장하지 않는다.
  maskedCard     String?
  cardBrand      String?

  /**
   * 요청 멱등키.
   *
   * 결제 요청이 재전송되면 같은 카드로 두 번 긁힌다. 손님 돈이 두 번 나가는
   * 일은 그 무엇보다 되돌리기 어렵다.
   */
  idempotencyKey String @unique

  failureReason String?
  authorizedAt  DateTime  @default(now())
  capturedAt    DateTime?
  voidedAt      DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folio     Folio     @relation(fields: [folioId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  postings  Posting[]

  @@index([folioId, status])
  @@map("payments")
}

enum RoomKeyStatus {
  ACTIVE
  /// 사람이 무효화했다. 분실·객실 변경·체크아웃.
  REVOKED
  /// 유효 기간이 지났다. 잠금장치가 알아서 거부한다.
  EXPIRED
}

/**
 * 발급된 객실 키.
 *
 * 실제 카드 데이터는 잠금장치 벤더가 들고 있고, 여기 남는 것은 **무엇을 언제
 * 누구에게 발급했는가** 다. 분실 신고가 들어왔을 때 어느 카드를 죽여야 하는지,
 * 체크아웃한 손님의 카드가 아직 살아 있지는 않은지 판단할 근거가 된다.
 */
model RoomKey {
  id            String @id @default(cuid())
  propertyId    String
  reservationId String
  roomNumber    String

  /// 벤더 시스템의 카드 식별자. 무효화할 때 이 값으로 지정한다.
  vendorKeyId String

  validFrom  DateTime
  validUntil DateTime

  status RoomKeyStatus @default(ACTIVE)
  /// 몇 번째 발급인지. 재발급이 잦은 객실은 따로 확인할 이유가 된다.
  sequence Int @default(1)

  issuedById    String?
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  issuedBy    User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, vendorKeyId])
  @@index([reservationId, status])
  @@index([propertyId, roomNumber, status])
  @@map("room_keys")
}

enum PostingType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  TAX
}

model Posting {
  id              String      @id @default(cuid())
  folioId         String
  type            PostingType
  /// OPERA transactionCode
  transactionCode String
  description     String
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("KRW")
  postedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())

  /// 외부 POS 가 단 요금이면 그 아웃렛. 프런트가 직접 올린 것은 null.
  outletId String?
  /// PG 결제가 만든 포스팅이면 그 결제. 대사할 때 쓴다.
  paymentId String?
  /**
   * POS 전표 번호.
   *
   * 네트워크가 끊겨 POS 가 같은 요청을 다시 보내는 일은 흔하다. 같은 아웃렛의
   * 같은 전표는 한 번만 달려야 한다 — 손님에게 두 번 청구되면 되돌리기 어렵다.
   */
  reference String?
  /// 취소된 포스팅이면 그 취소를 만든 조정 포스팅. 원본은 지우지 않는다.
  voidedById String? @unique

  /// 다른 창구에서 옮겨 왔으면 원래 창구. 감사에서 "왜 여기 있나" 를 설명한다.
  transferredFromWindow Int?
  transferredAt         DateTime?
  transferredById       String?

  folio         Folio      @relation(fields: [folioId], references: [id], onDelete: Cascade)
  outlet        PosOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  payment       Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  transferredBy User?      @relation(fields: [transferredById], references: [id])

  /// 이 포스팅을 취소한 조정. 값이 있으면 이미 취소된 것이다.
  voidedBy Posting? @relation("PostingVoid", fields: [voidedById], references: [id], onDelete: SetNull)
  /// 반대 방향 — 이 조정이 취소한 원본. 이름이 헷갈려 방향을 거꾸로 읽기 쉽다.
  voidedPosting Posting? @relation("PostingVoid")

  @@unique([outletId, reference])
  @@index([folioId, postedAt])
  @@map("postings")
}

// ---------------------------------------------------------------------------
// 운영 / 감사
// ---------------------------------------------------------------------------

enum SyncDirection {
  PULL
  PUSH
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Core 를 통한 OPERA 동기화 이력. 재시도·조사 목적.
model SyncLog {
  id         String        @id @default(cuid())
  entity     String
  entityId   String?
  direction  SyncDirection
  status     SyncStatus    @default(PENDING)
  error      String?
  payload    Json?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([entity, entityId])
  @@index([status, startedAt])
  @@map("sync_logs")
}
