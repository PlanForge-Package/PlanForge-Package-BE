// PlanForge BE — data model for the hotel management platform
//
// Follows Oracle OPERA Cloud's concepts (Property / Room Type / Profile /
// Reservation / Folio) but keeps PlanForge ids as primary keys and OPERA ids in
// `opera*Id` fields. Core matches on those when syncing with OHIP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts and permissions
// ---------------------------------------------------------------------------

/// Job roles, mirroring how a hotel is organised.
enum UserRole {
  /// Everything, including account management
  ADMIN
  /// Operations. No account management
  MANAGER
  /// Reservations, check-in/out, folios
  FRONT_DESK
  /// Room status changes only
  HOUSEKEEPING
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash. The plaintext is never stored anywhere.
  passwordHash String
  name         String
  role         UserRole  @default(FRONT_DESK)
  /// Home hotel. Null means access to all of them (head office).
  propertyId   String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  housekeepingTasks   HousekeepingTask[]
  issuedRoomKeys      RoomKey[]
  payments            Payment[]
  roomOutages         RoomOutage[]
  folioRoutings       FolioRouting[]
  transferredPostings Posting[]
  cashierShifts       CashierShift[]
  createdTraces       ReservationTrace[] @relation("TraceCreatedBy")
  completedTraces     ReservationTrace[] @relation("TraceCompletedBy")
  arTransactions      ArTransaction[]
  arInvoices          ArInvoice[]
  arAllocations       ArAllocation[]

  @@index([propertyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organisation and assets
// ---------------------------------------------------------------------------

model Property {
  id           String   @id @default(cuid())
  /// OPERA hotelId (hotel code within the chain)
  operaHotelId String   @unique
  name         String
  timezone     String   @default("Asia/Seoul")
  currency     String   @default("KRW")
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomTypes         RoomType[]
  rooms             Room[]
  ratePlans         RatePlan[]
  reservations      Reservation[]
  users             User[]
  housekeepingTasks HousekeepingTask[]
  blocks            Block[]
  posOutlets        PosOutlet[]
  roomKeys          RoomKey[]
  roomOutages       RoomOutage[]
  cashierShifts     CashierShift[]
  traces            ReservationTrace[]
  arAccounts        ArAccount[]
  arInvoices        ArInvoice[]

  @@map("properties")
}

model RoomType {
  id           String   @id @default(cuid())
  propertyId   String
  /// OPERA roomType code (e.g. DLXK)
  code         String
  name         String
  description  String?
  maxOccupancy Int      @default(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]

  @@unique([propertyId, code])
  @@map("room_types")
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

model Room {
  id         String     @id @default(cuid())
  propertyId String
  roomTypeId String
  /// OPERA roomId (room number)
  number     String
  floor      String?
  status     RoomStatus @default(CLEAN)
  occupied   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  housekeepingTasks HousekeepingTask[]
  outages           RoomOutage[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@map("rooms")
}

/// Two ways to take a room off sale. They report differently.
enum RoomOutageKind {
  /// Physically unusable. Leaves inventory, so the occupancy denominator drops.
  OUT_OF_ORDER
  /// The room is fine, we just are not selling it. Stays in the denominator.
  OUT_OF_SERVICE
}

/// Room outage. OPERA is the source; this is a copy.
model RoomOutage {
  id           String         @id @default(cuid())
  propertyId   String
  roomId       String
  /// Id OPERA assigned. Used to release the outage.
  operaId      String         @unique
  kind         RoomOutageKind
  /// First day out of service (inclusive)
  startDate    DateTime       @db.Date
  /// Last day out of service (inclusive). Not sellable through this date.
  endDate      DateTime       @db.Date
  reason       String
  /// Housekeeping status to restore when the outage ends
  returnStatus RoomStatus     @default(DIRTY)
  createdById  String?
  releasedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([propertyId, startDate, endDate])
  @@index([roomId, releasedAt])
  @@map("room_outages")
}

model RatePlan {
  id         String   @id @default(cuid())
  propertyId String
  /// OPERA rateCode
  code       String
  name       String
  /// Lowest sellable price (snapshot). Real rates come from OPERA through Core.
  baseAmount Decimal? @db.Decimal(12, 2)
  currency   String   @default("KRW")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([propertyId, code])
  @@map("rate_plans")
}

// ---------------------------------------------------------------------------
// Housekeeping assignments
// ---------------------------------------------------------------------------

/// Cleaning task progress. Different from RoomStatus —
/// this is how far staff got; that is whether the room can be sold.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  /// Inspected too. Grounds for raising room status to INSPECTED.
  INSPECTED
}

/**
 * Housekeeping assignment.
 * OPERA owns room status, but who cleans which room is staff scheduling and
 * never goes to OPERA. PlanForge owns it.
 */
model HousekeepingTask {
  id           String     @id @default(cuid())
  propertyId   String
  roomId       String
  /// Assigned staff member. Null until assigned.
  assignedToId String?
  /// Work date. The same room is a separate task on each date.
  date         DateTime   @db.Date
  status       TaskStatus @default(PENDING)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Two tasks for one room on one date leave nobody knowing who is responsible.
  @@unique([roomId, date])
  @@index([propertyId, date, status])
  @@index([assignedToId, date])
  @@map("housekeeping_tasks")
}

// ---------------------------------------------------------------------------
// Group blocks (OPERA Block)
// ---------------------------------------------------------------------------

/// OPERA block status. Inventory is actually held from DEFINITE onwards.
enum BlockStatus {
  INQUIRY
  TENTATIVE
  DEFINITE
  CANCELLED
  ACTUAL
}

/**
 * Local copy of a group block.
 * OPERA is the source. These rows are a cache for fast lists and search;
 * creates and updates are delegated through Core and then refilled with what
 * OPERA returned. Writing back what we sent would miss OPERA's adjustments.
 */
model Block {
  id            String      @id @default(cuid())
  /// OPERA blockId. Without it there is nothing to delegate against.
  operaBlockId  String?     @unique
  propertyId    String
  /// Block code used when booking
  code          String
  name          String
  status        BlockStatus @default(TENTATIVE)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// Past this date the held rooms return to general inventory.
  cutoffDate    DateTime?   @db.Date
  currency      String      @default("KRW")
  /// Total snapshot, refreshed on mirror so screens need not re-sum allotments.
  totalBlocked  Int         @default(0)
  totalPickedUp Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  allotments BlockAllotment[]

  @@unique([propertyId, code])
  @@index([propertyId, startDate])
  @@map("blocks")
}

/**
 * Allotment per date and room type.
 * roomType is a code string rather than an FK because OPERA can return a room
 * type we have not synced yet. An FK would fail the whole mirror and drop the
 * block from the screen entirely.
 */
model BlockAllotment {
  id           String   @id @default(cuid())
  blockId      String
  date         DateTime @db.Date
  roomTypeCode String
  /// Rooms held
  blocked      Int      @default(0)
  /// Rooms actually picked up
  pickedUp     Int      @default(0)
  ratePlanCode String?
  amount       Decimal? @db.Decimal(12, 2)

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, date, roomTypeCode])
  @@map("block_allotments")
}

// ---------------------------------------------------------------------------
// Profiles (OPERA Profile)
// ---------------------------------------------------------------------------

enum ProfileType {
  GUEST
  COMPANY
  TRAVEL_AGENT
  GROUP
}

/// Membership tier. Chains name these differently, so we store a code and let the screen label it.
enum MembershipTier {
  NONE
  SILVER
  GOLD
  PLATINUM
}

model Profile {
  id             String      @id @default(cuid())
  /// OPERA profileId
  operaProfileId String?     @unique
  type           ProfileType @default(GUEST)
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  nationality    String?
  vip            Boolean     @default(false)

  /// Membership number. The chain loyalty programme's identifier.
  membershipNumber String?
  membershipTier   MembershipTier @default(NONE)

  /**
   * Preferences that affect assignment — high floor, non-smoking, pillow type.
   * Codes rather than free text: as text, "high floor" and "upper floor" mix
   * together and nobody can filter on them at assignment time.
   */
  preferences String[] @default([])

  /// Internal note from the front desk. Never shown to the guest.
  notes String?

  /**
   * Target profile when this one was merged away as a duplicate.
   * Not deleted, because past reservations point at it. Deleting drops the guest
   * from those reservations; keeping it shows which one is current.
   */
  mergedIntoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  mergedInto   Profile?      @relation("ProfileMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Profile[]     @relation("ProfileMerge")
  arAccounts   ArAccount[]

  @@index([email])
  @@index([lastName, firstName])
  @@index([membershipNumber])
  @@index([mergedIntoId])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Reservations (OPERA Reservation)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  RESERVED
  CONFIRMED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  WAITLISTED
}

model Reservation {
  id                 String            @id @default(cuid())
  /// OPERA reservationId
  operaReservationId String?           @unique
  /// Confirmation number shown to the guest
  confirmationNumber String            @unique
  propertyId         String
  profileId          String
  roomTypeId         String
  ratePlanId         String?
  status             ReservationStatus @default(RESERVED)
  arrivalDate        DateTime          @db.Date
  departureDate      DateTime          @db.Date
  adults             Int               @default(1)
  children           Int               @default(0)
  /// Assigned room number. Null when unassigned.
  assignedRoomNumber String?
  /**
   * Reservations that share one room.
   * Two guests, one room, separate folios. Two reservations but only one room,
   * so they consume a single unit of inventory. Copied from OPERA as given.
   */
  shareGroupId       String?
  /// Block code, if this reservation was picked up from a group block.
  /// A code rather than an FK because a booking can arrive before the block is cached.
  blockCode          String?

  /**
   * Where the booking came from. Follows OPERA's three axes.
   * Collapsed into one field, a combination like "a corporate booking that came
   * through an OTA" is lost and channel profitability stops being answerable.
   */
  /// How it was taken — DIRECT · PHONE · WALKIN · OTA · GDS · CORPORATE
  sourceCode  String?
  /// What kind of guest — TRANSIENT · CORPORATE · GROUP · LEISURE · GOVERNMENT
  marketCode  String?
  /// The specific seller — WEB · BOOKINGCOM · EXPEDIA · YANOLJA …
  channelCode String?
  totalAmount Decimal? @db.Decimal(12, 2)
  currency    String   @default("KRW")
  notes       String?

  /**
   * Guarantee type — SIXPM · CREDITCARD · DEPOSIT · COMPANY · COMP.
   * It decides what we can charge on a no-show. 6PM only holds the room until
   * 18:00 and it may be sold after that; a card guarantee can be charged.
   * OPERA decides the value and this column is a copy.
   */
  guaranteeCode       String?
  /// Penalty charged on cancellation. Present only on cancelled reservations.
  cancellationPenalty Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  property       Property           @relation(fields: [propertyId], references: [id])
  profile        Profile            @relation(fields: [profileId], references: [id])
  roomType       RoomType           @relation(fields: [roomTypeId], references: [id])
  ratePlan       RatePlan?          @relation(fields: [ratePlanId], references: [id])
  folios         Folio[]
  roomKeys       RoomKey[]
  routings       FolioRouting[]
  traces         ReservationTrace[]
  arTransactions ArTransaction[]

  @@index([propertyId, arrivalDate])
  @@index([propertyId, status])
  @@index([propertyId, blockCode])
  @@index([propertyId, channelCode])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Accounting (OPERA Folio / Transaction)
// ---------------------------------------------------------------------------

enum FolioStatus {
  OPEN
  CLOSED
}

model Folio {
  id            String      @id @default(cuid())
  /// OPERA folioId
  operaFolioId  String?     @unique
  reservationId String
  /// OPERA folio window number (1-8)
  window        Int         @default(1)
  status        FolioStatus @default(OPEN)
  balance       Decimal     @default(0) @db.Decimal(12, 2)
  currency      String      @default("KRW")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  postings    Posting[]
  payments    Payment[]

  @@unique([reservationId, window])
  @@map("folios")
}

/**
 * Routing instruction — which window auto-posted charges go to.
 * The company paying room and the guest paying extras is a common split. Moving
 * each charge by hand always misses some, so the destination is decided per
 * transaction code up front.
 * It does not apply to charges the front desk posts to a chosen window — those
 * must land where they were sent. It applies to charges that arrive without a
 * window, such as an outside POS room charge.
 */
model FolioRouting {
  id              String   @id @default(cuid())
  reservationId   String
  /// OPERA transactionCode. Charges with this code go to targetWindow.
  transactionCode String
  targetWindow    Int
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id])

  @@unique([reservationId, transactionCode])
  @@map("folio_routings")
}

/**
 * Outside POS outlet — restaurant, bar, spa, minibar.
 * A charging party, not a person. Using a staff account would put a staff
 * password in the terminal and give it every staff permission. Each outlet gets
 * its own key, limited to posting room charges.
 */
model PosOutlet {
  id              String @id @default(cuid())
  propertyId      String
  /// Outlet code — RESTAURANT · BAR · SPA · MINIBAR
  code            String
  name            String
  /// Default transaction code for this outlet's charges
  transactionCode String

  /// bcrypt hash. The plaintext key exists only at the moment it is issued.
  apiKeyHash   String
  /// Leading characters kept so the screen can tell keys apart.
  apiKeyPrefix String
  /// Last time a key was issued. Consulted when a leak is suspected.
  keyIssuedAt  DateTime @default(now())

  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  postings Posting[]

  @@unique([propertyId, code])
  @@index([apiKeyPrefix])
  @@map("pos_outlets")
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum PaymentStatus {
  /// Authorised only. The limit is held but no money has moved.
  AUTHORIZED
  /// Captured. This is when the payment lands on the folio.
  CAPTURED
  /// Authorisation voided before capture.
  VOIDED
  /// Reversed after capture. A partial refund can leave an amount standing.
  REFUNDED
  FAILED
}

/**
 * Payment.
 * **Card numbers and CVV are never stored anywhere.** Only the masked last four
 * and the PSP's transaction id are kept. Storing them turns this system into
 * card-data storage and changes what a leak means.
 */
model Payment {
  id      String @id @default(cuid())
  folioId String

  method         PaymentMethod
  status         PaymentStatus @default(AUTHORIZED)
  amount         Decimal       @db.Decimal(12, 2)
  /// Total refunded. Several partial refunds are possible.
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("KRW")

  /// PSP transaction id. Capture, void and refund are issued against it.
  vendorTxnId    String?
  /// Approval number. Used when contacting the card issuer.
  approvalNumber String?
  /// Masked card number — last four only. The full number is never stored.
  maskedCard     String?
  cardBrand      String?

  /**
   * Request idempotency key.
   * A resent payment request charges the same card twice. Money leaving a guest
   * twice is harder to undo than anything else here.
   */
  idempotencyKey String @unique

  failureReason String?
  authorizedAt  DateTime  @default(now())
  capturedAt    DateTime?
  voidedAt      DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Shift that took it. Closing sums this shift's receipts against the drawer.
  shiftId String?

  folio     Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  postings  Posting[]
  shift     CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([folioId, status])
  @@index([shiftId])
  @@map("payments")
}

/// Department a trace goes to. Not a role — maintenance has no role but still gets instructions.
enum TraceDepartment {
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  FNB
  RESERVATION
}

enum TraceStatus {
  PENDING
  DONE
}

/**
 * Trace — a departmental instruction attached to a reservation.
 * "07:00 on arrival, housekeeping — crib", "manager greeting at check-in": work
 * a given department must do on a given date. Written in the reservation notes
 * instead, nobody reads it unless that department opens the reservation.
 * These are our own staff scheduling and do not go to OPERA — same reason as
 * housekeeping assignment. If OHIP has a trace API we will revisit delegating.
 */
model ReservationTrace {
  id            String          @id @default(cuid())
  propertyId    String
  reservationId String
  department    TraceDepartment
  /// Date this instruction is due
  dueDate       DateTime        @db.Date
  note          String
  status        TraceStatus     @default(PENDING)

  createdById   String?
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("TraceCreatedBy", fields: [createdById], references: [id])
  completedBy User?       @relation("TraceCompletedBy", fields: [completedById], references: [id])

  @@index([propertyId, dueDate, department, status])
  @@index([reservationId])
  @@map("reservation_traces")
}

/**
 * Cashier shift.
 * The front desk takes money in shifts. Without recording who took how much per
 * shift, a cash discrepancy leaves nobody to ask and no window to look at.
 * This is our own staff scheduling and does not go to OPERA — same reason as
 * housekeeping assignment. The money itself is already on the OPERA folio; this
 * only covers who took it and how much went into the drawer.
 */
model CashierShift {
  id         String    @id @default(cuid())
  propertyId String
  userId     String
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  /// Opening float. Cash put in to make change.
  openingFloat Decimal  @default(0) @db.Decimal(12, 2)
  /// Cash actually counted at close. Empty until then.
  countedCash  Decimal? @db.Decimal(12, 2)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([propertyId, closedAt])
  @@index([userId, closedAt])
  @@map("cashier_shifts")
}

enum RoomKeyStatus {
  ACTIVE
  /// Voided by a person. Lost card, room change, check-out.
  REVOKED
  /// Past its validity. The lock rejects it on its own.
  EXPIRED
}

/**
 * Issued room key.
 * The card data itself lives with the lock vendor; what stays here is **what was
 * issued, when, and to whom**. It is the basis for deciding which card to kill
 * on a loss report, and whether a departed guest's card is still alive.
 */
model RoomKey {
  id            String @id @default(cuid())
  propertyId    String
  reservationId String
  roomNumber    String

  /// Vendor's card id. Voiding is issued against this value.
  vendorKeyId String

  validFrom  DateTime
  validUntil DateTime

  status   RoomKeyStatus @default(ACTIVE)
  /// Which issue this is. Rooms reissued often are worth a look.
  sequence Int           @default(1)

  issuedById    String?
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  issuedBy    User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, vendorKeyId])
  @@index([reservationId, status])
  @@index([propertyId, roomNumber, status])
  @@map("room_keys")
}

enum PostingType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  TAX
}

model Posting {
  id              String      @id @default(cuid())
  /// OPERA postingId. The ledger's source is OPERA and this row is a copy.
  operaPostingId  String?     @unique
  folioId         String
  type            PostingType
  /// OPERA transactionCode
  transactionCode String
  description     String
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("KRW")
  postedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())

  /// Outlet, if an outside POS posted the charge. Null when the front desk did.
  outletId   String?
  /// Payment that created this posting, if any. Used when reconciling.
  paymentId  String?
  /**
   * POS check number.
   * A POS resending the same request after a network drop is common. One check
   * from one outlet must post once — a double charge is hard to undo.
   */
  reference  String?
  /// Adjustment that voided this posting. The original is never deleted.
  voidedById String? @unique

  /// Original window, if transferred in. Answers "why is this here" at audit.
  transferredFromWindow Int?
  transferredAt         DateTime?
  transferredById       String?

  folio         Folio      @relation(fields: [folioId], references: [id], onDelete: Cascade)
  outlet        PosOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  payment       Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  transferredBy User?      @relation(fields: [transferredById], references: [id])

  /// The adjustment that voided this posting. Set means already voided.
  voidedBy      Posting? @relation("PostingVoid", fields: [voidedById], references: [id], onDelete: SetNull)
  /// The other direction — the original this adjustment voided. Easy to read backwards.
  voidedPosting Posting? @relation("PostingVoid")

  @@unique([outletId, reference])
  @@index([folioId, postedAt])
  @@map("postings")
}

// ---------------------------------------------------------------------------
// AR / city ledger — direct-bill accounts
// ---------------------------------------------------------------------------

enum ArTransactionType {
  /// A charge billed to the account. Transferred from a folio or posted directly.
  CHARGE
  /// Payment received from the account
  PAYMENT
  /// Correction. The sign of the amount sets the direction.
  ADJUSTMENT
}

enum ArInvoiceStatus {
  /// Issued but not yet sent
  DRAFT
  SENT
  PAID
  /// Wrongly issued. Kept as void rather than deleted.
  VOID
}

/**
 * Direct-bill account (city ledger).
 * Charges are billed to a company or travel agency and invoiced at month end.
 * No money is taken at departure, so the amount leaves the folio and lands here.
 * We own this ledger — folios come from OPERA, but when and how much we billed
 * an account, and what is outstanding, is the hotel's receivables management.
 * If OHIP has an AR API we will revisit delegating.
 */
model ArAccount {
  id         String  @id @default(cuid())
  propertyId String
  /// Account code. The short identifier used on invoices and when reconciling.
  code       String
  name       String
  /// Linked profile (company or agency). Used to tie reservations to the account.
  profileId  String?

  /// Credit limit. Blocks new transfers once outstanding exceeds it. Null means none.
  creditLimit Decimal? @db.Decimal(12, 2)
  /// Payment terms in days. Invoice due dates are computed from this.
  termDays    Int      @default(30)

  billingEmail String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  profile      Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  transactions ArTransaction[]
  invoices     ArInvoice[]

  @@unique([propertyId, code])
  @@index([propertyId, active])
  @@map("ar_accounts")
}

/**
 * One line of the account ledger.
 * The balance is not stored. It is re-summed from the transactions every time —
 * incrementing leaves one failure as a permanent error. Same rule as folios.
 */
model ArTransaction {
  id          String            @id @default(cuid())
  accountId   String
  invoiceId   String?
  type        ArTransactionType
  /// Signed value. Charges are positive, payments negative.
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("KRW")
  description String

  /// Which reservation it came from. Traced back when reconciling.
  reservationId String?
  /// Source window, if transferred from a folio. Needed when a person checks.
  folioWindow   Int?

  postedAt    DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  account     ArAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice     ArInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  reservation Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation(fields: [createdById], references: [id])
  /// How much of this payment went to which invoice. Charges never appear here.
  allocations ArAllocation[]

  @@index([accountId, postedAt])
  @@index([invoiceId])
  @@map("ar_transactions")
}

/**
 * Invoice.
 * Collects unbilled transactions into one document. A transaction on an invoice
 * never joins another — billing twice makes the account pay twice.
 */
model ArInvoice {
  id         String          @id @default(cuid())
  propertyId String
  accountId  String
  /// Invoice number. The identifier exchanged with the account.
  number     String
  status     ArInvoiceStatus @default(DRAFT)

  /// Total at issue. Later transactions do not change this value.
  total    Decimal   @db.Decimal(12, 2)
  currency String    @default("KRW")
  issuedAt DateTime  @default(now())
  dueDate  DateTime  @db.Date
  sentAt   DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  note     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  account      ArAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions ArTransaction[]
  allocations  ArAllocation[]
  createdBy    User?           @relation(fields: [createdById], references: [id])

  @@unique([propertyId, number])
  @@index([accountId, status])
  @@map("ar_invoices")
}

/**
 * Record of a payment applied to an invoice.
 * An account may split one invoice across payments, or settle several at once.
 * With only a payment total we cannot say what an invoice still owes, and so
 * cannot decide who to chase for how much.
 * An allocation is the intersection of a payment and an invoice, so it goes when either does.
 */
model ArAllocation {
  id        String @id @default(cuid())
  invoiceId String
  /// The payment applied. Always PAYMENT.
  paymentId String

  amount Decimal @db.Decimal(12, 2)

  createdById String?
  createdAt   DateTime @default(now())

  invoice   ArInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   ArTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id])

  /// Applying one payment to one invoice twice would understate what we received.
  @@unique([invoiceId, paymentId])
  @@index([paymentId])
  @@map("ar_allocations")
}

// ---------------------------------------------------------------------------
// Operations / audit
// ---------------------------------------------------------------------------

enum SyncDirection {
  PULL
  PUSH
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

/// OPERA sync history through Core. For retries and investigation.
model SyncLog {
  id         String        @id @default(cuid())
  entity     String
  entityId   String?
  direction  SyncDirection
  status     SyncStatus    @default(PENDING)
  error      String?
  payload    Json?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([entity, entityId])
  @@index([status, startedAt])
  @@map("sync_logs")
}
